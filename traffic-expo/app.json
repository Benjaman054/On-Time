{
  "expo": {
    "name": "ON-Time",
    "slug": "traffic-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/robot.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.benny.ontime"
    },
    "android": {
      "package": "com.benny.ontime",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/robot.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-secure-store",
      "expo-localization",
      "@react-native-google-signin/google-signin"
    ],
    "extra": {
      "eas": {
        "projectId": "40ffd085-b8c5-442e-ba21-1195f6da4785"
      }
    }
  }
}
